# Destination Lens API. Copy to .env and fill in what you need; never commit .env.

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173

# Reviews shown by default start here (YYYY-MM); empty = all time
DEFAULT_SINCE=2025-01

# Fine-tuned classifier (needed to build clusters, not to serve them)
MODEL_DIR=model
# MODEL_URL=https://huggingface.co/<user>/<private-repo>/resolve/main/<model>.zip
# MODEL_URL_TOKEN=<read token>

# Gemini, for short or Hindi-English reviews while building clusters (optional)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Where cluster files live (default: backend/clusters)
# CLUSTER_DIR=clusters
